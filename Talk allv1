local MESSAGES = {
    "LA V1.64 LOADING BY Pmaiexz.dex",
    "RESONANSE V2.9",
    "XOCU",
    "ReverseFTAP",
    "Venom X Hub",
    "Mercury",
     "Sleepy hub",
     "RESONANSE V2.10",
}
local DELAY = 1

local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function getChannel()
    local ch = TextChatService:FindFirstChild("RBXGeneral", true)
    if not ch then
        local tc = TextChatService:FindFirstChild("TextChannels")
        if tc then ch = tc:FindFirstChild("RBXGeneral") end
    end
    if ch and ch:IsA("TextChannel") then return ch end
    return nil
end

local function send(msg)
    local ch = getChannel()
    if ch then
        pcall(function() ch:SendAsync(msg) end)
        return true
    end
    local ok = pcall(function()
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if not ev then return end
        local say = ev:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(msg, "All") end
    end)
    return ok
end

for i, msg in ipairs(MESSAGES) do
    send(msg)
    if i < #MESSAGES then task.wait(DELAY) end
end
