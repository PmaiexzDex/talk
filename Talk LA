local MESSAGE = "LA V1.64 LOADING BY Pmaiexz.dex", "RESONANSE V2.9", "XOCU","ReverseFTAP", "Venom X Hub" ,"Mercury" , "Sleepy hub","Resitstance", "RESONANSE V2.10"
local DELAY   = 1               

local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function getChannel()
    local ch = TextChatService:FindFirstChild("RBXGeneral", true)
    if not ch then
        local tc = TextChatService:FindFirstChild("TextChannels")
        if tc then ch = tc:FindFirstChild("RBXGeneral") end
    end
    if ch and ch:IsA("TextChannel") then return ch end
    return nil
end

local function sendWord(word)
    local ch = getChannel()
    if ch then
        pcall(function() ch:SendAsync(word) end)
        return true
    end
    -- fallback legacy
    local ok = pcall(function()
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if not ev then return end
        local say = ev:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(word, "All") end
    end)
    return ok
end

-- แยกคำด้วยช่องว่าง (รองรับภาษาไทย)
local words = {}
for w in string.gmatch(MESSAGE, "%S+") do
    table.insert(words, w)
end

-- ส่งทีละคำ
for i, w in ipairs(words) do
    sendWord(w)
    if i < #words then
        task.wait(DELAY)
    end
end
